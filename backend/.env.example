PORT=3000

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET= 741243f00af7ab8f91e2dfaa2e4fbc7a8af9e66948e5a09552d05f2565ff52c1

# PostgreSQL — use Render's managed Postgres in production
# Render gives you a single connection string — prefer DATABASE_URL over the
# individual DB_* vars below when deploying there.
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flowforge
DB_PORT=5432
DB_SSL=false
# OR use a single connection string (Render provides this as the "Internal/External Database URL"):
# DATABASE_URL=postgresql://user:password@host:port/database
# Render's managed Postgres requires SSL on the external URL — config/db.js already
# sets { rejectUnauthorized: false } automatically whenever DATABASE_URL is set.

# Redis — use Render's managed Redis, or Upstash, in production
REDIS_HOST=localhost
REDIS_PORT=6379
# OR use a single connection string:
# REDIS_URL=redis://default:password@host:port

# Frontend URL — used for CORS and OAuth redirects
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Gmail App Password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# Twilio WhatsApp — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google OAuth — https://console.cloud.google.com
# Authorized redirect URI must be: https://your-render-url.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
